{
  "name": "obsidian-metadata-validator",
  "version": "0.2.12",
  "description": "Manifest-driven metadata validation, auto-fix, and field picker for Obsidian.",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "dev:vault": "node esbuild.config.mjs && bash test-vault/.obsidian/plugins/metadata-validator/install.sh",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "install:vault": "bash test-vault/.obsidian/plugins/metadata-validator/install.sh",
    "build:vault": "npm run build && bash test-vault/.obsidian/plugins/metadata-validator/install.sh",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.ts\" manifest.json package.json versions.json version-bump.mjs",
    "format:check": "prettier --check \"src/**/*.ts\" manifest.json package.json versions.json version-bump.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "knip": "knip",
    "lint-staged": "lint-staged",
    "prepare": "husky"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "prettier --write",
      "eslint --fix"
    ],
    "{manifest,package,versions}.json": [
      "prettier --write"
    ],
    "version-bump.mjs": [
      "prettier --write"
    ]
  },
  "keywords": [],
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "9.30.1",
    "@eslint/json": "^1.2.0",
    "@types/node": "^16.11.6",
    "@vitest/coverage-v8": "^4.1.2",
    "esbuild": "0.25.5",
    "eslint": "^9.39.4",
    "eslint-plugin-obsidianmd": "0.1.9",
    "globals": "14.0.0",
    "husky": "^9.1.7",
    "jsdom": "^29.0.1",
    "knip": "^6.3.0",
    "lint-staged": "^16.4.0",
    "obsidian-test-mocks": "^1.0.11",
    "prettier": "^3.8.1",
    "tslib": "2.4.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "8.35.1",
    "vitest": "^4.1.2"
  },
  "dependencies": {
    "obsidian": "latest"
  }
}
