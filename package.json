{
  "name": "obsidian-metadata-validator",
  "version": "0.3.11",
  "description": "Manifest-driven metadata validation, auto-fix, and field picker for notes.",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "dev:vault": "node esbuild.config.mjs && bash test-vault/.obsidian/plugins/metadata-validator/install.sh",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "install:vault": "bash test-vault/.obsidian/plugins/metadata-validator/install.sh",
    "build:vault": "npm run build && bash test-vault/.obsidian/plugins/metadata-validator/install.sh",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "obsidian:lint": "eslint .",
    "format": "prettier --write \"src/**/*.ts\" manifest.json package.json versions.json version-bump.mjs",
    "format:check": "prettier --check \"src/**/*.ts\" manifest.json package.json versions.json version-bump.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "knip": "knip",
    "nano-staged": "nano-staged",
    "prepare": "husky"
  },
  "nano-staged": {
    "src/**/*.ts": [
      "prettier --write",
      "eslint --fix"
    ],
    "{manifest,package,versions}.json": [
      "prettier --write"
    ],
    "version-bump.mjs": [
      "prettier --write"
    ]
  },
  "keywords": [],
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^1.2.0",
    "@types/node": "^20.19.39",
    "@vitest/coverage-v8": "^4.1.5",
    "esbuild": "^0.28.0",
    "eslint": "^10.2.1",
    "eslint-plugin-obsidianmd": "^0.2.8",
    "globals": "^17.5.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.0",
    "knip": "^6.7.0",
    "nano-staged": "^1.0.2",
    "obsidian-test-mocks": "^1.1.1",
    "prettier": "^3.8.3",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.1",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "obsidian": "latest"
  }
}
